.state-card {
  margin-top: 24rpx;
  padding: 42rpx 32rpx;
  text-align: center;
}

.state-card .title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.state-card .subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-visual {
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 26rpx;
  background: #ecfbf7;
}

.state-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #79d5c7;
}

.state-loading .state-dot {
  animation: state-breathe 1.1s ease-in-out infinite;
}

.state-loading .state-dot:nth-child(2) { animation-delay: 120ms; }
.state-loading .state-dot:nth-child(3) { animation-delay: 240ms; }

@keyframes state-breathe {
  0%, 100% { opacity: .35; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-5rpx); }
}

.state-symbol {
  color: #5d9f95;
  font-size: 34rpx;
  font-weight: 700;
}

.state-error .state-visual {
  color: #d65763;
  background: #fff0f2;
}

.action-btn {
  width: 240rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
}
