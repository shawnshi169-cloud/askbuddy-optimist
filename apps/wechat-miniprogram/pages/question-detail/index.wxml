<view class="page-shell detail-page">
  <view class="app-header detail-header">
    <view class="app-header-bar detail-title-bar" style="{{navLayout.headerStyle}}">
      <view class="back-button" bindtap="goBack">‹</view>
      <view class="app-header-title">问题详情</view>
    </view>
  </view>

  <view class="page-content detail-page-content question-detail-content">
    <state-card wx:if="{{loading}}" type="loading" title="加载中" desc="正在获取问题详情" />
    <state-card wx:elif="{{error}}" type="error" title="加载失败" desc="{{error}}" actionText="重试" bind:action="loadDetail" />

    <view wx:else>
      <view wx:if="{{isExample}}" class="detail-preview-banner">当前为频道体验内容，不代表线上真实问题。</view>
      <view class="asker-strip rise-in">
        <view class="avatar asker-avatar">{{detail.asker_initial}}</view>
        <view class="asker-copy">
          <view class="asker-name">{{detail.asker_name}}</view>
          <view class="asker-time">{{detail.created_at_text}}</view>
        </view>
        <view class="asker-metric">◉ {{detail.view_count_text}}</view>
        <view class="asker-points">◇ {{detail.reward_points_text}}</view>
      </view>

      <view class="card question-body-card rise-in">
        <view class="question-eyebrow">问题正文</view>
        <view class="detail-title">{{detail.title}}</view>
        <view class="detail-content">{{detail.content || '暂无详细描述'}}</view>
        <view class="question-tools">
          <button class="tool-button {{favorited ? 'active' : ''}}" bindtap="toggleFavorite">{{favorited ? '已收藏' : '收藏'}}</button>
          <button class="tool-button" open-type="share">分享</button>
        </view>
        <view class="report-link" bindtap="reportContent">举报内容</view>
      </view>

      <view class="card answers-card rise-in">
        <view class="answer-header">
          <view>
            <view class="answer-title">回答 ({{answers.length}})</view>
            <view class="answer-caption">优先查看高质量回答，再决定是否继续补充提问。</view>
          </view>
          <view class="quality-pill">优质回答</view>
        </view>

        <state-card wx:if="{{!answers.length}}" type="empty" title="暂无回答" desc="当前问题还没有公开回答" />

        <view wx:for="{{answers}}" wx:key="id" class="answer-item">
          <view class="answer-author-row">
            <view class="avatar answer-avatar">{{item.author_initial}}</view>
            <view class="answer-author-copy">
              <view class="answer-author-name">{{item.author_name}}</view>
              <view class="answer-author-role">回答者</view>
            </view>
            <view wx:if="{{item.is_accepted}}" class="accepted-pill">已采纳</view>
          </view>
          <view class="answer-content">{{item.content}}</view>
          <view class="answer-meta">
            <text>{{item.created_at_text}}</text>
            <text>◉ {{item.likes_count || 0}}</text>
            <text class="reply-link" data-author="{{item.author_name}}" bindtap="replyAnswer">回复</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !error}}" class="fixed-action-bar detail-action-bar">
    <button class="button-primary detail-primary-action" bindtap="answerQuestion">我来回答</button>
    <button class="button-secondary detail-secondary-action" open-type="share">邀请回答</button>
  </view>

  <view wx:if="{{answerEditorVisible}}" class="answer-editor-mask" catchtap="closeAnswerEditor">
    <view class="answer-editor-sheet" catchtap="keepAnswerEditor">
      <view class="answer-editor-handle" />
      <view class="answer-editor-heading"><view><view class="answer-editor-title">写回答</view><view class="answer-editor-subtitle">分享真实经验和可执行建议</view></view><view class="answer-editor-close" bindtap="closeAnswerEditor">×</view></view>
      <textarea class="answer-editor-input" value="{{answerDraft}}" maxlength="2000" placeholder="先说明你的判断，再给出具体步骤…" bindinput="onAnswerInput" />
      <view class="answer-editor-note">请勿填写手机号等隐私信息</view>
      <button class="button-primary answer-editor-submit" bindtap="submitAnswer">提交回答</button>
    </view>
  </view>
</view>
