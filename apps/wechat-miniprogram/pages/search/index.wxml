<view class="page-shell search-page">
  <view class="app-header search-header">
    <view class="app-header-bar search-title-bar" style="{{navLayout.headerStyle}}">
      <view class="back-button" bindtap="goBack" hover-class="header-control-pressed" hover-stay-time="80" aria-role="button" aria-label="返回">‹</view>
      <view class="app-header-title">搜索</view>
      <view class="search-notice" bindtap="goNotifications" hover-class="header-control-pressed" hover-stay-time="80" aria-role="button" aria-label="查看提醒">
        <view class="search-bell-cap"></view>
        <view class="search-bell-body"></view>
        <view class="search-bell-clapper"></view>
      </view>
    </view>
    <view class="search-box">
      <view class="search-icon" />
      <input
        class="search-input"
        placeholder="搜索问题 / 专家 / 技能 / 动态"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onConfirmSearch"
        focus="{{false}}"
      />
      <view class="search-submit" bindtap="onConfirmSearch">搜索</view>
    </view>
  </view>

  <view class="page-content search-content">
    <view wx:if="{{!hasSearched}}" class="hot-search rise-in">
      <view class="hot-title-row">
        <view class="hot-search-icon" />
        <view class="section-title">热门搜索</view>
      </view>
      <view class="hot-keywords">
        <view
          wx:for="{{hotKeywords}}"
          wx:key="*this"
          class="chip hot-chip"
          data-keyword="{{item}}"
          bindtap="chooseHotKeyword"
        >{{item}}</view>
      </view>
    </view>

    <view wx:if="{{hasSearched}}" class="search-results">
      <view class="segmented result-tabs">
        <view class="segment-item {{activeType === 'all' ? 'active' : ''}}" data-type="all" bindtap="switchType">综合</view>
        <view class="segment-item {{activeType === 'question' ? 'active' : ''}}" data-type="question" bindtap="switchType">问题</view>
        <view class="segment-item {{activeType === 'expert' ? 'active' : ''}}" data-type="expert" bindtap="switchType">专家</view>
        <view class="segment-item {{activeType === 'skill' ? 'active' : ''}}" data-type="skill" bindtap="switchType">技能</view>
        <view class="segment-item {{activeType === 'post' ? 'active' : ''}}" data-type="post" bindtap="switchType">动态</view>
      </view>
      <view class="preview-banner">当前仅 question（问题）读取能力可用；expert、skill、post 暂显示明确空态。</view>

      <state-card wx:if="{{loading}}" type="loading" title="搜索中" desc="正在整理与“{{keyword}}”相关的内容" />
      <state-card wx:elif="{{error}}" type="error" title="搜索失败" desc="{{error}}" actionText="重试" bind:action="runSearch" />

      <view wx:elif="{{activeType === 'all'}}" class="result-list overview-list">
        <state-card wx:if="{{!resultBag.question.length && !resultBag.expert.length && !resultBag.skill.length && !resultBag.post.length}}" type="empty" title="没有找到相关内容" desc="换一个关键词试试" />
        <view wx:if="{{resultBag.question.length}}" class="result-group-title-row"><view class="result-group-title">相关问题</view><view class="group-more" data-type="question" bindtap="showResultGroup">查看全部</view></view>
        <view wx:for="{{resultBag.question}}" wx:key="id" class="card result-card question-result rise-in" bindtap="goQuestionDetail" data-id="{{item.id}}" hover-class="result-card-pressed">
          <view class="result-title line-clamp-2">{{item.title}}</view>
          <view class="result-desc line-clamp-2">{{item.content || '暂无详细描述'}}</view>
          <view class="result-meta"><text class="result-tag">#{{item.category_label}}</text><text>◉ {{item.view_count_text}}</text></view>
        </view>
        <view wx:if="{{resultBag.expert.length}}" class="result-group-title-row"><view class="result-group-title">相关达人</view><view class="group-more" data-type="expert" bindtap="showResultGroup">查看全部</view></view>
        <view wx:for="{{resultBag.expert}}" wx:key="result_key" class="card result-card expert-result rise-in" bindtap="goExpertDetail" data-id="{{item.result_key}}" data-type="expert" hover-class="result-card-pressed">
          <view class="avatar result-avatar">{{item.initial}}</view>
          <view class="result-copy"><view class="result-title">{{item.nickname || item.title || '未命名专家'}}</view><view class="result-desc line-clamp-2">{{item.headline || item.intro || item.bio || '等待完善个人介绍'}}</view></view>
          <view wx:if="{{item.verified}}" class="verified-pill">认证</view>
        </view>
        <view wx:if="{{resultBag.skill.length}}" class="result-group-title-row"><view class="result-group-title">相关技能</view><view class="group-more" data-type="skill" bindtap="showResultGroup">查看全部</view></view>
        <view wx:for="{{resultBag.skill}}" wx:key="result_key" class="card result-card skill-result rise-in" bindtap="goExpertDetail" data-id="{{item.result_key}}" data-type="skill" hover-class="result-card-pressed">
          <view class="skill-mark">技</view>
          <view class="result-copy"><view class="result-title">{{item.title || '未命名技能'}}</view><view class="result-desc">{{item.category_name || item.description || '技能服务'}}</view></view>
          <view wx:if="{{item.price_amount}}" class="price-text">¥{{item.price_amount}}</view>
        </view>
        <view wx:if="{{resultBag.post.length}}" class="result-group-title-row"><view class="result-group-title">相关动态</view><view class="group-more" data-type="post" bindtap="showResultGroup">查看全部</view></view>
        <view wx:for="{{resultBag.post}}" wx:key="result_key" class="card result-card post-result rise-in" bindtap="goPost" data-id="{{item.result_key}}" hover-class="result-card-pressed">
          <view class="post-author-row"><view class="avatar post-avatar">问</view><view><view class="post-author">问问用户</view><view class="post-time">经验动态</view></view></view>
          <view class="result-desc post-content">{{item.content || item.title || '暂无内容'}}</view>
        </view>
      </view>

      <view wx:elif="{{activeType === 'question'}}" class="result-list">
        <state-card wx:if="{{!resultBag.question.length}}" type="empty" title="暂无问题结果" desc="试试更具体的关键词" />
        <view wx:for="{{resultBag.question}}" wx:key="id" class="card result-card question-result rise-in" bindtap="goQuestionDetail" data-id="{{item.id}}" hover-class="result-card-pressed">
          <view class="result-title line-clamp-2">{{item.title}}</view>
          <view class="result-desc line-clamp-2">{{item.content || '暂无详细描述'}}</view>
          <view class="result-meta">
            <text class="result-tag">#{{item.category_label}}</text>
            <text>◉ {{item.view_count_text}}</text>
          </view>
        </view>
      </view>

      <view wx:elif="{{activeType === 'expert'}}" class="result-list">
        <state-card wx:if="{{!resultBag.expert.length}}" type="empty" title="专家搜索准备中" desc="expert 搜索契约尚未接入当前基线" />
        <view wx:for="{{resultBag.expert}}" wx:key="result_key" class="card result-card expert-result rise-in" bindtap="goExpertDetail" data-id="{{item.result_key}}" data-type="expert" hover-class="result-card-pressed">
          <view class="avatar result-avatar">{{item.initial}}</view>
          <view class="result-copy">
            <view class="result-title">{{item.nickname || item.title || '未命名专家'}}</view>
            <view class="result-desc line-clamp-2">{{item.headline || item.intro || item.bio || '等待完善个人介绍'}}</view>
          </view>
          <view wx:if="{{item.verified}}" class="verified-pill">认证</view>
        </view>
      </view>

      <view wx:elif="{{activeType === 'skill'}}" class="result-list">
        <state-card wx:if="{{!resultBag.skill.length}}" type="empty" title="技能搜索准备中" desc="skill 搜索契约尚未接入当前基线" />
        <view wx:for="{{resultBag.skill}}" wx:key="result_key" class="card result-card skill-result rise-in" bindtap="goExpertDetail" data-id="{{item.result_key}}" data-type="skill" hover-class="result-card-pressed">
          <view class="skill-mark">技</view>
          <view class="result-copy">
            <view class="result-title">{{item.title || '未命名技能'}}</view>
            <view class="result-desc">{{item.category_name || item.description || '技能服务'}}</view>
          </view>
          <view wx:if="{{item.price_amount}}" class="price-text">¥{{item.price_amount}}</view>
        </view>
      </view>

      <view wx:else class="result-list">
        <state-card wx:if="{{!resultBag.post.length}}" type="empty" title="动态搜索准备中" desc="post 搜索契约尚未接入当前基线" />
        <view wx:for="{{resultBag.post}}" wx:key="result_key" class="card result-card post-result rise-in" bindtap="goPost" data-id="{{item.result_key}}" hover-class="result-card-pressed">
          <view class="post-author-row">
            <view class="avatar post-avatar">问</view>
            <view>
              <view class="post-author">问问用户</view>
              <view class="post-time">经验动态</view>
            </view>
          </view>
          <view class="result-desc post-content">{{item.content || item.title || '暂无内容'}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
