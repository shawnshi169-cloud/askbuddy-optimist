page { background: #f8fdfb; }
.section-header { background: linear-gradient(135deg,#75cfc1,#8bd9cd); }
.section-header-bar { height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; }
.section-header-title { margin-left: 4rpx; color: #fff; font-size: 30rpx; font-weight: 600; }
.section-content { padding: 30rpx; }
.section-intro { padding: 28rpx; display: flex; align-items: center; gap: 20rpx; border: 1px solid #cdefe7; border-radius: 32rpx; background: linear-gradient(135deg,#ecfbf7,#fff); }
.section-icon { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 24rpx; color: #fff; background: linear-gradient(135deg,#70d0c1,#4daa9d); font-size: 29rpx; font-weight: 700; }
.section-subtitle { margin-top: 5rpx; color: #71847f; font-size: 21rpx; }
.section-list,.draft-card { margin-top: 24rpx; padding: 8rpx 28rpx; border-radius: 32rpx; }
.draft-list { display: flex; flex-direction: column; }
.section-row { min-height: 94rpx; display: flex; align-items: center; gap: 16rpx; border-bottom: 1px solid #edf3f1; }
.section-row:last-child { border-bottom: 0; }
.section-row.selected { margin: 7rpx -12rpx; padding: 0 12rpx; border-bottom-color: transparent; border-radius: 22rpx; background: #effaf7; }
.row-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #79d5c7; }
.row-label { flex: 1; color: #334155; font-size: 24rpx; }
.row-arrow { color: #94a3b8; font-size: 38rpx; }
.empty-section { padding: 110rpx 40rpx 60rpx; text-align: center; }
.empty-illustration { width: 116rpx; height: 116rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 38rpx; color: #45988c; background: #e9f8f5; font-size: 36rpx; font-weight: 700; }
.empty-title { margin-top: 28rpx; color: #334155; font-size: 29rpx; font-weight: 700; }
.empty-desc { margin-top: 10rpx; color: #94a3b8; font-size: 22rpx; line-height: 1.7; }
.draft-card { padding: 28rpx; }
.draft-label { color: #4e9b90; font-size: 20rpx; }
.draft-title { margin-top: 10rpx; color: #1e293b; font-size: 28rpx; font-weight: 700; }
.draft-desc { margin-top: 10rpx; color: #64748b; font-size: 22rpx; line-height: 1.6; }
.draft-actions { margin-top: 20rpx; display: flex; justify-content: space-between; color: #94a3b8; font-size: 19rpx; }
.delete-draft { color: #e15d67; }
.feedback-card { margin-top: 22rpx; padding: 28rpx; }
.feedback-label { color: #334155; font-size: 24rpx; font-weight: 700; }
.feedback-card textarea { width: 100%; height: 260rpx; margin-top: 18rpx; padding: 20rpx; border-radius: 22rpx; background: #f5faf8; box-sizing: border-box; color: #334155; font-size: 23rpx; line-height: 1.7; }
.feedback-footer { margin-top: 12rpx; display: flex; justify-content: space-between; color: #94a3b8; font-size: 19rpx; }
.feedback-save { width: 100%; height: 74rpx; margin: 24rpx 0 0; line-height: 74rpx; }
.contract-tip { margin: 26rpx 10rpx; color: #94a3b8; font-size: 19rpx; line-height: 1.65; text-align: center; }
