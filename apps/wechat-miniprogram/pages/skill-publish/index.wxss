page { background: #f8fdfb; }
.skill-header { background: linear-gradient(135deg, #75cfc1, #8bd9cd); }
.skill-header-bar { height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; }
.skill-header-title { margin-left: 4rpx; color: #fff; font-size: 30rpx; font-weight: 600; }
.draft-link { margin-left: auto; color: #fff; font-size: 22rpx; }
.skill-content { padding: 30rpx; }
.publish-tip { padding: 26rpx; display: flex; gap: 18rpx; border-radius: 30rpx; color: #315f59; background: linear-gradient(135deg, #e9faf6, #fff); border: 1px solid #cdefe7; }
.tip-icon { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; flex: none; border-radius: 22rpx; color: #fff; background: linear-gradient(135deg, #f3b254, #ec8747); font-weight: 700; }
.tip-title { font-size: 25rpx; font-weight: 700; }
.tip-desc { margin-top: 5rpx; color: #6d827f; font-size: 21rpx; line-height: 1.6; }
.form-card { margin-top: 22rpx; border-radius: 32rpx; }
.form-label { color: #334155; font-size: 25rpx; font-weight: 700; }
.title-input { height: 78rpx; margin-top: 15rpx; padding: 0 22rpx; border-radius: 22rpx; background: #f5f8f7; box-sizing: border-box; font-size: 24rpx; }
.category-options { margin-top: 18rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.category-option { padding: 12rpx 20rpx; border: 1px solid #dcefeb; border-radius: 999rpx; color: #64748b; font-size: 21rpx; }
.category-option.active { color: #2f7d72; border-color: #91dace; background: #ecfbf7; font-weight: 700; }
.description-input { width: 100%; height: 250rpx; margin-top: 16rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: #f5f8f7; box-sizing: border-box; font-size: 24rpx; line-height: 1.7; }
.contract-note { margin-top: 22rpx; color: #94a3b8; font-size: 20rpx; line-height: 1.65; }
.skill-submit { width: 100%; min-width: 0; height: 78rpx; margin: 0; padding: 0; line-height: 78rpx; }
