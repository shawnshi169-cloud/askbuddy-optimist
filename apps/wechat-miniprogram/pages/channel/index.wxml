<view class="page-shell channel-page channel-{{channel.tone}}">
  <view class="channel-header">
    <view class="channel-header-bar" style="{{navLayout.headerStyle}}">
      <view class="back-button" bindtap="goBack" hover-class="header-control-pressed" hover-stay-time="80" aria-role="button" aria-label="返回">‹</view>
      <view class="channel-title">{{channel.name}}</view>
      <view class="channel-header-spacer" />
      <view class="header-icon-button bell-button" bindtap="goNotifications" hover-class="header-control-pressed" hover-stay-time="80" aria-role="button" aria-label="查看提醒">
        <view class="bell-cap"></view>
        <view class="bell-body"></view>
        <view class="bell-clapper"></view>
      </view>
    </view>
    <view class="channel-search" bindtap="goSearch" hover-class="header-control-pressed" hover-stay-time="80" aria-role="button" aria-label="搜索当前频道">
      <view class="search-glyph" />
      <text>搜索问题 / 达人 / 话题</text>
    </view>
  </view>

  <view class="channel-content">
    <view wx:if="{{channel.featured}}" class="card featured-card rise-in" bindtap="openFeatured" hover-class="channel-card-pressed">
      <view class="featured-badge">本周精选</view>
      <view class="featured-title">{{channel.featured.title}}</view>
      <view class="featured-description">{{channel.featured.description}}</view>
      <view class="featured-footer">
        <text>{{channel.featured.hint}}</text>
        <text class="featured-link">查看专题 ›</text>
      </view>
    </view>
    <state-card wx:else type="empty" title="频道专题准备中" desc="正式专题契约接入后将在这里展示" />

    <scroll-view class="subcategory-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="subcategory-track">
        <view
          wx:for="{{channel.subcategories}}"
          wx:key="id"
          class="subcategory-chip {{activeCategory === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectCategory"
          hover-class="subcategory-chip-pressed"
        >
          <view class="subcategory-symbol">{{item.short}}</view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="segmented channel-segmented">
      <view class="segment-item {{activeFeed === 'questions' ? 'active' : ''}}" data-feed="questions" bindtap="switchFeed">大家都在问</view>
      <view class="segment-item {{activeFeed === 'experts' ? 'active' : ''}}" data-feed="experts" bindtap="switchFeed">找TA问问</view>
    </view>

    <view wx:if="{{presentationEnabled}}" class="channel-preview-banner">专题与达人资料为 development 视觉预览，不代表真实业务数据。</view>

    <state-card wx:if="{{activeFeed === 'questions' && loading}}" type="loading" title="正在加载" desc="正在整理频道内容" />
    <state-card wx:elif="{{activeFeed === 'questions' && error}}" type="error" title="加载失败" desc="{{error}}" actionText="重试" bind:action="loadData" />
    <state-card wx:elif="{{activeFeed === 'questions' && !questions.length}}" type="empty" title="还没有相关问题" desc="当前频道没有可展示的问题。" />

    <view wx:if="{{activeFeed === 'questions' && !loading && questions.length}}" class="channel-list">
      <view wx:for="{{questions}}" wx:key="id" class="card channel-question rise-in" bindtap="openQuestion" data-id="{{item.id}}" hover-class="channel-card-pressed">
        <view class="question-heading">
          <view class="question-title line-clamp-2">{{item.title}}</view>
          <view class="question-views">◉ {{item.view_count_text}}</view>
        </view>
        <view class="question-description line-clamp-2">{{item.content}}</view>
        <view class="question-author">
          <view class="author-block">
            <view class="avatar">{{item.asker_initial}}</view>
            <view>
              <view class="author-name">{{item.asker_name}}</view>
              <view class="author-time">{{item.created_at_text}}</view>
            </view>
          </view>
          <view class="points-pill">◇ {{item.reward_points_text}} 积分</view>
        </view>
        <view class="question-bottom">
          <view class="topic-chip">#{{item.category_label}}</view>
          <view class="answer-cta">回答</view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeFeed === 'experts'}}" class="channel-list">
      <state-card wx:if="{{!experts.length}}" type="empty" title="达人资料准备中" desc="正式达人读取契约接入后将在这里展示" />
      <view wx:for="{{experts}}" wx:key="id" class="card channel-expert rise-in" bindtap="openExpert" data-id="{{item.id}}" hover-class="channel-card-pressed">
        <view class="expert-row">
          <view class="avatar expert-avatar">{{item.initial}}</view>
          <view class="expert-copy">
            <view class="expert-name-row">
              <text class="expert-name">{{item.name}}</text>
              <text wx:if="{{item.verified}}" class="verified-badge">已认证</text>
              <text wx:else class="verified-badge">资料预览</text>
            </view>
            <view class="expert-title">{{item.title}}</view>
            <view class="expert-description line-clamp-2">{{item.bio}}</view>
          </view>
        </view>
        <view class="expert-tags">
          <text wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text>
        </view>
        <view class="expert-meta">
          <text>★ {{item.rating}}</text>
          <text>回复率 {{item.responseRate}}</text>
          <text>{{item.orderCount}} 单</text>
        </view>
        <view class="expert-cta">查看主页</view>
      </view>
    </view>
  </view>

  <view class="channel-fab" bindtap="goAsk" hover-class="channel-fab-pressed">+</view>
</view>
