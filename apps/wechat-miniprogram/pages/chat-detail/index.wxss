page { background: #f4faf8; }
.chat-page { min-height: 100vh; }
.chat-header { background: linear-gradient(135deg, #75cfc1, #8bd9cd); }
.chat-header-bar { height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; }
.chat-user { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; }
.chat-identity { flex: 1; min-width: 0; }
.chat-avatar, .bubble-avatar { display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #52755c; background: #f8db68; font-weight: 700; }
.chat-avatar { width: 58rpx; height: 58rpx; }
.chat-name { overflow: hidden; color: #fff; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.chat-status { overflow: hidden; color: rgba(255,255,255,.78); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.chat-call { margin-left: 10rpx; padding: 9rpx 14rpx; flex: none; border-radius: 999rpx; color: #fff; background: rgba(255,255,255,.2); font-size: 19rpx; }
.chat-scroll { height: calc(100vh - env(safe-area-inset-top) - 188rpx - env(safe-area-inset-bottom)); padding: 26rpx 24rpx; box-sizing: border-box; }
.chat-date { margin-bottom: 24rpx; color: #94a3b8; font-size: 19rpx; text-align: center; }
.message-row { margin-bottom: 24rpx; display: flex; align-items: flex-start; gap: 12rpx; }
.message-row.mine { justify-content: flex-end; }
.bubble-avatar { width: 54rpx; height: 54rpx; flex: none; font-size: 20rpx; }
.message-bubble { max-width: 520rpx; padding: 20rpx 24rpx; border-radius: 26rpx 26rpx 26rpx 8rpx; color: #334155; background: #fff; box-shadow: 0 8rpx 22rpx rgba(15,23,42,.05); font-size: 24rpx; line-height: 1.6; }
.mine .message-bubble { border-radius: 26rpx 26rpx 8rpx 26rpx; color: #285d55; background: #a9e8de; }
.message-time { margin-top: 6rpx; color: #a1adbd; font-size: 17rpx; }
.mine .message-time { text-align: right; }
.demo-note { margin: 34rpx 20rpx; color: #94a3b8; font-size: 19rpx; line-height: 1.6; text-align: center; }
.chat-composer { position: fixed; left: 0; right: 0; bottom: 0; padding: 14rpx 22rpx calc(env(safe-area-inset-bottom) + 12rpx); display: flex; gap: 12rpx; background: #fff; border-top: 1px solid #dcefeb; }
.chat-composer input { flex: 1; height: 70rpx; padding: 0 22rpx; border-radius: 999rpx; background: #f2f6f5; font-size: 23rpx; }
.chat-composer button { width: 110rpx; min-width: 0; height: 70rpx; margin: 0; padding: 0; line-height: 70rpx; color: #285d55; background: #8eddd1; font-size: 22rpx; }

@media (max-width: 360px) {
  .chat-status {
    display: none;
  }

  .chat-avatar {
    width: 52rpx;
    height: 52rpx;
  }

  .chat-call {
    padding-left: 11rpx;
    padding-right: 11rpx;
  }
}
