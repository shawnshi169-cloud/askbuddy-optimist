page { background: #f8fdfb; }
.post-editor-header { background: linear-gradient(135deg,#75cfc1,#8bd9cd); }
.post-editor-bar { height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; }
.post-editor-title { margin-left: 4rpx; color: #fff; font-size: 30rpx; font-weight: 600; }
.publish-link { margin-left: auto; color: #fff; font-size: 22rpx; font-weight: 600; }
.post-editor-content { padding: 30rpx; }
.editor-card,.media-card,.tag-card,.city-card { border-radius: 32rpx; }
.editor-card textarea { width: 100%; height: 300rpx; font-size: 25rpx; line-height: 1.75; }
.editor-count { color: #94a3b8; font-size: 19rpx; text-align: right; }
.media-preview-grid { margin-top: 22rpx; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; }
.media-preview-item { position: relative; height: 204rpx; overflow: hidden; border-radius: 24rpx; background: #e7f2ef; }
.media-preview-item image { width: 100%; height: 100%; }
.media-remove { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: rgba(24,45,41,.72); font-size: 28rpx; }
.media-card,.city-card { margin-top: 22rpx; display: flex; align-items: center; gap: 18rpx; }
.media-icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; color: #fff; background: linear-gradient(135deg,#6fcdbc,#50a99c); font-weight: 700; }
.media-title { color: #334155; font-size: 24rpx; font-weight: 700; }
.media-desc { margin-top: 5rpx; color: #94a3b8; font-size: 20rpx; }
.media-arrow { margin-left: auto; color: #94a3b8; font-size: 40rpx; }
.tag-card { margin-top: 22rpx; }
.tag-list { margin-top: 18rpx; display: flex; flex-wrap: wrap; gap: 13rpx; }
.tag-item { padding: 10rpx 18rpx; border: 1px solid #dcefeb; border-radius: 999rpx; color: #64748b; font-size: 21rpx; }
.tag-item.active { color: #348176; border-color: #8ed9ce; background: #ecfbf7; }
.city-card { justify-content: space-between; }
.editor-contract { margin-top: 24rpx; color: #94a3b8; font-size: 20rpx; text-align: center; }
.editor-submit { width: 100%; min-width: 0; height: 78rpx; margin: 0; padding: 0; line-height: 78rpx; }
