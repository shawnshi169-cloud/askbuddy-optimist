page { background: #f8fdfb; }
.expert-page { background: linear-gradient(180deg, #75cfc1 0, #a1e3d8 400rpx, #f8fdfb 401rpx); }
.expert-sticky-header { position: sticky; top: 0; z-index: 90; color: #fff; background: linear-gradient(135deg, #75cfc1, #8ad8cd); box-shadow: 0 8rpx 24rpx rgba(38, 109, 99, .12); }
.expert-hero { color: #fff; }
.expert-header-bar { height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; box-sizing: border-box; }
.expert-header-title { margin-left: 4rpx; font-size: 30rpx; font-weight: 600; }
.expert-share { width: 96rpx !important; max-width: 96rpx; min-width: 96rpx; height: 52rpx; margin: 0 0 0 auto; padding: 0; line-height: 52rpx; color: #fff; background: rgba(255, 255, 255, .18); font-size: 21rpx; }
.expert-identity { padding: 34rpx 30rpx 68rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.expert-avatar-large { width: 142rpx; height: 142rpx; display: flex; align-items: center; justify-content: center; border: 7rpx solid rgba(255, 255, 255, .7); border-radius: 50%; color: #3f8178; background: linear-gradient(135deg, #fff3b9, #f7d658); box-shadow: 0 16rpx 34rpx rgba(35, 100, 91, .2); font-size: 48rpx; font-weight: 800; }
.expert-name-row { margin-top: 20rpx; display: flex; align-items: center; gap: 12rpx; }
.expert-name { font-size: 34rpx; font-weight: 700; }
.verified { padding: 5rpx 13rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .2); font-size: 19rpx; }
.expert-title { margin-top: 8rpx; color: rgba(255, 255, 255, .9); font-size: 24rpx; }
.expert-location { margin-top: 9rpx; color: rgba(255, 255, 255, .8); font-size: 21rpx; }
.follow-button { width: 150rpx; height: 58rpx; margin: 22rpx 0 0; padding: 0; line-height: 58rpx; color: #347c72; background: #fff; font-size: 22rpx; }
.expert-content { margin-top: -36rpx; padding: 0 30rpx; position: relative; z-index: 3; }
.expert-stats { padding: 28rpx 18rpx; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); text-align: center; }
.expert-stats view { display: flex; flex-direction: column; gap: 4rpx; border-right: 1px solid #e6f1ef; }
.expert-stats view:last-child { border-right: 0; }
.expert-stats text:first-child { color: #1e293b; font-size: 29rpx; font-weight: 700; }
.expert-stats text:last-child { color: #94a3b8; font-size: 19rpx; }
.expert-section { margin-top: 22rpx; border-radius: 34rpx; }
.expert-bio { margin-top: 18rpx; color: #536174; font-size: 24rpx; line-height: 1.75; }
.expert-tags { margin-top: 18rpx; display: flex; gap: 12rpx; color: #438f84; font-size: 21rpx; }
.section-heading-row, .service-meta, .review-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.service-price { color: #e5883b; font-size: 24rpx; font-weight: 700; }
.service-card { margin-top: 18rpx; padding: 24rpx; border-radius: 26rpx; background: #f6fbfa; }
.service-title { color: #334155; font-size: 26rpx; font-weight: 700; }
.service-desc { margin-top: 10rpx; color: #64748b; font-size: 22rpx; line-height: 1.7; }
.service-meta { margin-top: 18rpx; justify-content: flex-start; color: #8a98aa; font-size: 19rpx; }
.review-row { margin-top: 20rpx; align-items: flex-start; }
.review-avatar { background: linear-gradient(135deg, #e9f8f5, #fff4cd); }
.review-copy { flex: 1; }
.review-author { color: #334155; font-size: 23rpx; font-weight: 700; }
.review-text { margin-top: 7rpx; color: #64748b; font-size: 22rpx; line-height: 1.6; }
.review-score { color: #f0b447; font-size: 17rpx; white-space: nowrap; }
.expert-actions button { flex: 1; width: 0; min-width: 0; height: 76rpx; margin: 0; padding: 0; line-height: 76rpx; }
.message-button { color: #3e7f76; }
