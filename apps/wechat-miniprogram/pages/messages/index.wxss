.messages-page {
  background: #f8fdfb;
}

.messages-header {
  min-height: 0;
  padding: env(safe-area-inset-top) 0 0;
  display: block;
}

.messages-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.message-tabs {
  height: 100%;
  display: flex;
  align-items: flex-end;
  gap: 42rpx;
}

.message-tab {
  position: relative;
  padding: 0 2rpx 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  font-weight: 600;
}

.message-tab.active {
  color: #ffffff;
}

.message-tab.active::after {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 7rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #ffffff;
  content: "";
}

.header-unread {
  position: absolute;
  right: -28rpx;
  top: -5rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ef5b67;
  font-size: 17rpx;
  line-height: 28rpx;
  text-align: center;
}

.message-search {
  margin-left: auto;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.message-search-pressed {
  opacity: .66;
  transform: scale(.92);
}

.message-search-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.message-search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #ffffff;
  transform: rotate(45deg);
  content: "";
}

.messages-content {
  padding-top: 34rpx;
}

.message-search-panel {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.message-search-field {
  flex: 1;
  height: 72rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 1px solid #dcefeb;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.message-search-field input {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
}

.message-search-field-icon {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #6a837f;
  border-radius: 50%;
}

.search-cancel {
  color: #4c9b90;
  font-size: 22rpx;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 8rpx 20rpx;
}

.list-label {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 600;
}

.list-count {
  color: #94a3b8;
  font-size: 20rpx;
}

.call-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx;
}

.conversation-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.conversation-card {
  position: relative;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 30rpx;
}

.conversation-avatar {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  color: #4a8179;
  background: linear-gradient(135deg, #fff1ad, #f7d552);
  font-size: 28rpx;
  font-weight: 800;
}

.conversation-copy {
  flex: 1;
  min-width: 0;
}

.conversation-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.conversation-name {
  color: #1e293b;
  font-size: 25rpx;
  font-weight: 700;
}

.conversation-time,
.conversation-message,
.contract-caption {
  color: #94a3b8;
  font-size: 19rpx;
}

.conversation-message {
  margin-top: 7rpx;
  color: #64748b;
  font-size: 21rpx;
}

.conversation-unread {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ef5b67;
  font-size: 18rpx;
}

.contract-caption {
  margin: 20rpx 8rpx 0;
  line-height: 1.6;
}

.call-entry-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #63bcae, #9de3d7);
  font-size: 20rpx;
  font-weight: 700;
}

.call-entry-copy {
  flex: 1;
  min-width: 0;
}

.call-entry-title {
  color: #1e293b;
  font-size: 27rpx;
  font-weight: 700;
}

.call-entry-desc {
  margin-top: 5rpx;
  color: #64748b;
  font-size: 21rpx;
}

.chevron {
  color: #94a3b8;
  font-size: 38rpx;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 26rpx;
  border-radius: 32rpx;
}

.notification-card.unread {
  background: linear-gradient(135deg, #ffffff, #f2fcf9);
}

.notification-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 24rpx;
  color: #3e8f83;
  background: #e8f8f4;
  font-size: 25rpx;
  font-weight: 700;
}

.notification-copy {
  flex: 1;
  min-width: 0;
}

.notification-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.notification-title {
  color: #1e293b;
  font-size: 26rpx;
  font-weight: 700;
}

.notification-time {
  flex: none;
  color: #94a3b8;
  font-size: 18rpx;
}

.notification-type {
  margin-top: 3rpx;
  color: #70bdb2;
  font-size: 19rpx;
}

.notification-content {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.55;
}

.dot {
  position: absolute;
  right: 16rpx;
  top: 18rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef5b67;
}

@media (max-width: 360px) {
  .messages-header-bar {
    padding-left: 22rpx;
  }

  .message-tabs {
    gap: 30rpx;
  }

  .message-tab {
    font-size: 26rpx;
  }
}
